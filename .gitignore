# Claude Code — local / user-specific
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json

# Application data — personal, never committed (see spec/job-application R-6)
/job-application/
*.pdf
*.docx

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/
.python-version

# MkDocs build output
/site/

# Task runner cache
.task/

# Audits — local-only, except the license-check records that the release
# workflow reads from develop (release-publish.yml, job license-verdict);
# SBOMs and scratch files next to them stay local
.audits/*
!.audits/license-check/
.audits/license-check/*
!.audits/license-check/license-*.md

# Environment
.env
.env.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Eval results hold model output and costs; they are local
evals/results/
